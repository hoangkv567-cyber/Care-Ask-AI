# ==========================================================================
# MẪU BIẾN MÔI TRƯỜNG - sao chép thành .env rồi điền giá trị thật của bạn:
#     cp .env.example .env
# File .env KHÔNG được commit (đã bị .gitignore chặn).
# ==========================================================================

# Neo4j Aura
NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-neo4j-password>

# ------------------------- VỌNG CHẨN (đọc ảnh lưỡi / sắc mặt) -------------------------
# Chuỗi dự phòng, chạy theo đúng thứ tự này (src/cloud_vlm_client.py: create_vision_client):
#     DashScope qwen3-vl-32b-thinking  ->  Requesty parasail/qwen25-vl-72b  ->  LLaVA local
# Chỉ khi đường CHÍNH chạy được thì vọng chẩn mới đi đường JSON CÓ CẤU TRÚC (tất định). Đường
# dự phòng chỉ có prose, phải nhờ LLM khớp triệu chứng — kém tin cậy hơn hẳn.

# Alibaba Model Studio (DashScope) — VLM CHÍNH.
# Lấy tại https://modelstudio.console.alibabacloud.com/ap-southeast-1  (tab API-key)
DASHSCOPE_API_KEY=<your-dashscope-key>

# Requesty router — VLM dự phòng, ĐỒNG THỜI là LLM cho phần văn bản (trích triệu chứng, biện luận).
# REQUESTY_VISION_API_KEY để trống thì dùng chung REQUESTY_API_KEY.
REQUESTY_API_KEY=<your-requesty-key>
REQUESTY_VISION_API_KEY=

# ------------------------- ĐĂNG NHẬP FIREBASE (tuỳ chọn) -------------------------
# Thiếu FIREBASE_PROJECT_ID -> mọi token Firebase bị TỪ CHỐI (không thể kiểm chữ ký).
FIREBASE_PROJECT_ID=
# Chỉ dùng trên máy dev: bỏ qua kiểm chữ ký token. TUYỆT ĐỐI không bật khi triển khai.
FIREBASE_ALLOW_INSECURE_DEV=

# Đường dẫn dữ liệu CSV (mặc định đọc trong repo)
TCM_CSV_PATH=data/Medicine_clean.csv

# ĐÃ BỎ, giữ lại chỉ để tương thích ngược — không cần điền:
#   HUGGINGFACE_TOKEN / HF_TOKEN  (bỏ 2026-07-20: HF router hay 504, chỉ tổ chờ vô ích)
#   SILICONFLOW_API_KEY           (bỏ: hết quota, đã chuyển sang Requesty)
#   OPENROUTER_API_KEY

# [XÁC THỰC] Khoá ký JWT — BẮT BUỘC đặt khi chạy thật (sinh bằng: python -c "import secrets;print(secrets.token_urlsafe(48))")
# Không đặt -> hệ tự sinh khoá tạm, mọi phiên đăng nhập mất hiệu lực sau mỗi lần khởi động lại.
JWT_SECRET=
JWT_TTL_HOURS=12
