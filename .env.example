# ==========================================================================
# MẪU BIẾN MÔI TRƯỜNG - sao chép thành .env rồi điền giá trị thật của bạn:
#     cp .env.example .env
# File .env KHÔNG được commit (đã bị .gitignore chặn).
# ==========================================================================

# Neo4j Aura
NEO4J_URI=neo4j+s://<your-instance>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<your-neo4j-password>

# LLM providers (chỉ cần điền cái bạn dùng)
HUGGINGFACE_TOKEN=<your-hf-token>
OPENROUTER_API_KEY=<your-openrouter-key>
SILICONFLOW_API_KEY=<your-siliconflow-key>

# Đường dẫn dữ liệu CSV (mặc định đọc trong repo)
TCM_CSV_PATH=data/Medicine_clean.csv
